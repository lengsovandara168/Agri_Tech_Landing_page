<section id="how" class="section-pad">
  <div class="container-w">
    <h2 class="kh text-2xl md:text-3xl font-semibold mb-5">ជួយអ្នកកសិកម្មតាមរយៈ 4 សេវាកម្មសំខាន់</h2>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
        <h3 class="kh text-lg font-semibold mb-2 text-slate-900">ដំបូន្មានថែទាំដំណាំ</h3>
        <p class="kh text-slate-600 leading-relaxed">ការស្រោចទឹក ការបំពង់ជី ការកាត់ច្រឹប និងកាលវិភាគថែទាំសម្រាប់ដំណាំពេញនិយមនៅកម្ពុជា។</p>
      </div>
      <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
        <h3 class="kh text-lg font-semibold mb-2 text-slate-900">ស្គាល់សត្វល្អិត និងជំងឺ</h3>
        <p class="kh text-slate-600 leading-relaxed">ស្វែងរកមូលហេតុ និងដំណោះស្រាយប្រកបដោយសុវត្ថិភាពសម្រាប់ការពារជីវជាតិ និងបរិស្ថាន។</p>
      </div>
      <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
        <h3 class="kh text-lg font-semibold mb-2 text-slate-900">គ្រប់គ្រងដី</h3>
        <p class="kh text-slate-600 leading-relaxed">យល់ដឹងអំពីតុល្យភាពជាតិដី ការបង្កើនជីជាតិ និងការបង្កើតដីមានជីជាតិខ្ពស់។</p>
      </div>
      <div class="bg-white border border-slate-200 rounded-xl p-5 shadow-sm">
        <h3 class="kh text-lg font-semibold mb-2 text-slate-900">ចីរភាព និងធន់ទ្រាំអាកាសធាតុ</h3>
        <p class="kh text-slate-600 leading-relaxed">អនុសាសន៍អនុវត្តន៍ដែលថោក ប៉ុន្តែមានប្រសិទ្ធភាពសម្រាប់ការកាត់បន្ថយភាពហានិភ័យ និងបង្កើនផល។</p>
      </div>
    </div>
  </div>
</section>
