---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Agri‑Tech Cambodia — AI Farming Advice in Khmer</title>
		<meta name="description" content="Agri‑Tech is a Cambodian startup building an AI-powered chatbot that gives instant, reliable farming advice in Khmer for home growers and smallholder farmers." />

		<!-- Font is loaded via global.css (Kantumruy Pro) -->

		<!-- Open Graph / Twitter -->
		<meta property="og:title" content="Agri‑Tech Cambodia — AI Farming Advice in Khmer" />
		<meta property="og:description" content="Instant, localized crop care, pest control, and sustainable practices guidance — all in Khmer." />
		<meta property="og:type" content="website" />
		<meta property="og:image" content="/logo.svg" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content="Agri‑Tech Cambodia — AI Farming Advice in Khmer" />
		<meta name="twitter:description" content="Instant, localized crop care, pest control, and sustainable practices guidance — all in Khmer." />
		<meta name="twitter:image" content="/logo.svg" />
	</head>
	<body class="min-h-screen flex flex-col">
		<Header />
		<main class="flex-1">
			<slot />
		</main>
		<Footer />
		<Analytics />
	</body>
</html>

